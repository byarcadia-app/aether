{
  "expo": {
    "name": "aether-example",
    "slug": "aether-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aetherexample",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arcadia.aether-example"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
