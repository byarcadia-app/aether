{
  "name": "@byarcadia-app/aether",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/byarcadia-app/aether#readme",
  "license": "MIT",
  "author": "Dominik Woźniak <dominik@byarcadia.app> (github.com/dominikwozniak)",
  "repository": {
    "type": "git",
    "url": "https://github.com/byarcadia-app/aether"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.mjs",
      "require": "./dist/icons/index.js"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind/index.d.ts",
      "import": "./dist/tailwind/index.mjs",
      "require": "./dist/tailwind/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "release": "pnpm build && changeset publish",
    "version": "changeset version",
    "check": "tsc --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "example:start": "pnpm --filter @byarcadia-app/example start",
    "example:ios": "pnpm --filter @byarcadia-app/example ios"
  },
  "dependencies": {
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@callstack/liquid-glass": "^0.7.0",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@expo-google-fonts/inter": "^0.4.2",
    "@types/react": "^19.2.14",
    "expo-haptics": "^14.0.1",
    "expo-linear-gradient": "^14.0.1",
    "expo-symbols": "^1.0.8",
    "nativewind": "^4.2.2",
    "oxfmt": "^0.34.0",
    "oxlint": "^1.49.0",
    "react": "^19.2.4",
    "react-native": "^0.84.0",
    "react-native-reanimated": "^4.1.5",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@callstack/liquid-glass": ">=0.7",
    "@expo-google-fonts/inter": ">=0.4.2",
    "expo-haptics": ">=14",
    "expo-linear-gradient": ">=14",
    "expo-symbols": ">=1",
    "nativewind": ">=4",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-reanimated": ">=3",
    "tailwindcss": "^3.3.5"
  },
  "peerDependenciesMeta": {
    "expo-symbols": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.14.0"
}
